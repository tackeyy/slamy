{
  "name": "slamy",
  "version": "2.1.0",
  "description": "Slack CLI tool and library for TypeScript",
  "type": "module",
  "engines": {
    "node": ">=25"
  },
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "bin": {
    "slamy": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:consumer": "node scripts/test-package-consumer.mjs",
    "ci:cost-check": "node scripts/check-actions-cost-guard.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "lint": "npm run lint:md",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#dist\" \"#go-src\" \"#.changeset/*.md\"",
    "changeset": "changeset",
    "release": "npm run build && changeset publish"
  },
  "dependencies": {
    "@slack/bolt": "^4.7.3",
    "@slack/web-api": "^7.16.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "markdownlint-cli2": "^0.23.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "files": [
    "dist"
  ]
}
