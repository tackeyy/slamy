{
  "name": "slamy",
  "version": "2.1.0",
  "description": "Slack CLI tool and library for TypeScript",
  "type": "module",
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "bin": {
    "slamy": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "npm run lint:md",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#dist\" \"#go-src\" \"#.changeset/*.md\"",
    "changeset": "changeset",
    "release": "npm run build && changeset publish"
  },
  "dependencies": {
    "@slack/bolt": "^4.6.0",
    "@slack/web-api": "^7.16.0",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@types/node": "^22.13.5",
    "@vitest/coverage-v8": "^3.1.0",
    "markdownlint-cli2": "^0.22.1",
    "typescript": "^6.0.3",
    "vitest": "^3.1.0"
  },
  "files": [
    "dist"
  ]
}
